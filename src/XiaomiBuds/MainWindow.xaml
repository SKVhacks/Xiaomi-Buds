<Window
    x:Class="XiaomiBuds.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Xiaomi Buds">

    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <!-- row 1 reserved for top-level tabs (Xiaomi Share, later) -->
        <!-- one chip per pair of earbuds, shown when more than one pair is paired -->
        <ScrollViewer x:Name="DeviceStripHost" Grid.Row="2" Visibility="Collapsed"
                      HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="DeviceStrip" Orientation="Horizontal" Spacing="8" Padding="24,2,24,6"
                        HorizontalAlignment="Center"/>
        </ScrollViewer>
        <Grid x:Name="AppTitleBar" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image x:Name="TitleIcon" Width="16" Height="16"/>
                <TextBlock Text="Xiaomi Buds" FontSize="12" VerticalAlignment="Center"
                           Foreground="{ThemeResource Text2Brush}"/>
            </StackPanel>
        </Grid>
        <ContentControl x:Name="Host" Grid.Row="3"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
</Window>

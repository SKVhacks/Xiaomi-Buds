<UserControl
    x:Class="XiaomiBuds.Views.PairView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="32">
        <HyperlinkButton NavigateUri="https://gadgetvishwa.in" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                         Foreground="{ThemeResource AccentBrushX}" FontSize="12.5" FontWeight="SemiBold"
                         ToolTipService.ToolTip="gadgetvishwa.in">
            <TextBlock Text="Crafted By Gadget Vishwa"/>
        </HyperlinkButton>
        <StackPanel MaxWidth="420" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="0">
            <Image x:Name="Hero" Height="190" HorizontalAlignment="Center" Margin="0,0,0,28"/>
            <TextBlock Text="Pair your earbuds" Style="{StaticResource LargeTitleStyle}" FontSize="26"
                       HorizontalAlignment="Center" TextAlignment="Center"/>
            <TextBlock Style="{StaticResource CaptionStyle}" FontSize="14" TextAlignment="Center" Margin="0,10,0,0"
                       Text="Open the case near your PC, then press and hold the button on the case for 3 seconds until the light blinks. Pair the buds in Windows Bluetooth settings, and they'll show up here."/>
            <Button Content="Open Bluetooth settings" Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Center" Margin="0,26,0,0" Click="OpenSettings_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,22,0,0">
                <ProgressRing IsActive="True" Width="14" Height="14"/>
                <TextBlock Text="Looking for paired devices" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>

<UserControl
    x:Class="XiaomiBuds.Views.BudsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="620" Padding="24,4,24,36">

            <!-- Header -->
            <Grid Margin="4,6,4,0">
                <StackPanel>
                    <Button x:Name="NameButton" Padding="0" Background="Transparent" BorderThickness="0" IsHitTestVisible="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="NameText" Style="{StaticResource LargeTitleStyle}" MaxWidth="440"/>
                            <FontIcon x:Name="NameChevron" Glyph="&#xE70D;" FontSize="14" Visibility="Collapsed"
                                      Foreground="{ThemeResource Text2Brush}" VerticalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" Spacing="7" Margin="1,4,0,0">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" FontSize="13" Foreground="{ThemeResource Text2Brush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <Button x:Name="ReconnectButton" Content="Reconnect" Style="{StaticResource LinkButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="Reconnect_Click"/>
            </Grid>

            <!-- Battery on official product images -->
            <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0" Padding="8,24,8,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="ArtRow" Height="150"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- split art: separate left bud / case / right bud -->
                    <Image x:Name="LeftImg" Height="112" VerticalAlignment="Center"/>
                    <Image x:Name="CaseImg" Grid.Column="1" Height="146" VerticalAlignment="Center"/>
                    <Image x:Name="RightImg" Grid.Column="2" Height="112" VerticalAlignment="Center"/>
                    <!-- hero art: one photo of the case with the buds -->
                    <Image x:Name="HeroImg" Grid.ColumnSpan="3" Height="190" VerticalAlignment="Center"
                           HorizontalAlignment="Center" Visibility="Collapsed"/>
                    <TextBlock Grid.Row="1" Text="Left" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Case" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Right" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <ContentControl x:Name="LeftBattHost" Grid.Row="2" HorizontalAlignment="Center"/>
                    <ContentControl x:Name="CaseBattHost" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center"/>
                    <ContentControl x:Name="RightBattHost" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <Border x:Name="ExperimentalNote" Background="{ThemeResource AccentSoftBrush}" CornerRadius="12"
                    Padding="14,10" Margin="0,12,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ExperimentalText" Style="{StaticResource CaptionStyle}" FontSize="12.5"
                           Foreground="{ThemeResource Text1Brush}"/>
            </Border>

            <StackPanel x:Name="ControlsPanel">
                <!-- Noise control -->
                <StackPanel x:Name="NoiseSection">
                    <TextBlock Text="Noise control" Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Style="{StaticResource CardStyle}" Padding="16,20,16,16">
                        <StackPanel Spacing="18">
                            <Grid x:Name="ModeRow"/>
                            <StackPanel x:Name="StrengthPanel" Spacing="10">
                                <TextBlock x:Name="StrengthTitle" Style="{StaticResource CaptionStyle}" Margin="2,0,0,0"/>
                                <ContentControl x:Name="StrengthHost" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                            <StackPanel x:Name="AdaptiveAncHost" Margin="-16,-8,-16,-16"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Sound -->
                <StackPanel x:Name="SoundSection">
                    <TextBlock Text="Sound" Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Style="{StaticResource CardStyle}" Padding="0">
                        <StackPanel x:Name="SoundList"/>
                    </Border>
                </StackPanel>

                <!-- Find -->
                <StackPanel x:Name="FindSection">
                    <TextBlock Text="Find earbuds" Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="14">
                            <TextBlock Style="{StaticResource CaptionStyle}" FontSize="13"
                                       Text="Plays a loud sound so you can find your earbuds. Take them out of your ears first."/>
                            <Grid x:Name="FindButtons" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="FindLeft" Content="Left" Style="{StaticResource ChipButtonStyle}" Click="FindLeft_Click"/>
                                <Button x:Name="FindBoth" Grid.Column="1" Content="Both" Style="{StaticResource ChipButtonStyle}" Click="FindBoth_Click"/>
                                <Button x:Name="FindRight" Grid.Column="2" Content="Right" Style="{StaticResource ChipButtonStyle}" Click="FindRight_Click"/>
                            </Grid>
                            <Button x:Name="FindStop" Content="Stop sound" Style="{StaticResource ChipButtonStyle}"
                                    Foreground="{ThemeResource RedBrush}" Visibility="Collapsed" Click="FindStop_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Settings -->
                <StackPanel x:Name="SettingsSection">
                    <TextBlock Text="Settings" Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Style="{StaticResource CardStyle}" Padding="0">
                        <StackPanel x:Name="SettingsList"/>
                    </Border>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="About" Style="{StaticResource SectionHeaderStyle}"/>
            <Border Style="{StaticResource CardStyle}" Padding="0">
                <StackPanel x:Name="AboutList"/>
            </Border>
            <StackPanel HorizontalAlignment="Center" Margin="16,18,16,0" Spacing="2">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5">
                    <TextBlock Style="{StaticResource CaptionStyle}" FontSize="12" VerticalAlignment="Center" Text="Product images ©"/>
                    <Image x:Name="MiLogo" Height="16" VerticalAlignment="Center" ToolTipService.ToolTip="Xiaomi"/>
                    <TextBlock x:Name="MiText" Style="{StaticResource CaptionStyle}" FontSize="12" VerticalAlignment="Center"
                               Text="Xiaomi" Visibility="Collapsed"/>
                    <TextBlock Style="{StaticResource CaptionStyle}" FontSize="12" VerticalAlignment="Center"
                               Text="· Control protocol based on Gadgetbridge"/>
                </StackPanel>
                <HyperlinkButton NavigateUri="https://gadgetvishwa.in" Padding="6,2" HorizontalAlignment="Center"
                                 Foreground="{ThemeResource AccentBrushX}" FontSize="12" FontWeight="SemiBold"
                                 ToolTipService.ToolTip="gadgetvishwa.in">
                    <TextBlock Text="Crafted By Gadget Vishwa" FontSize="12"/>
                </HyperlinkButton>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
